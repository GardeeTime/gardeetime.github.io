---
import { getCollection } from "astro:content";
import Desktop from "../layouts/Desktop.astro";
import SeedPacket from "../components/garden/SeedPacket.astro";
import WateringLog from "../components/garden/WateringLog.astro";

const work = await getCollection("work");
const featured = work
  .filter((e) => e.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 6);

const testimonials = (await getCollection("testimonials")).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const noteTints = ["#fbe6b0", "#f8faf1", "#f6d3c8", "#dceccd"];

const stakes = [
  { key: "Now", value: "Ten months in at Backstroke. Shipping features, breaking things, learning to ship." },
  { key: "Before", value: "Six years at Salesloft (Senior PM to Senior Staff). First PM at Lessonly." },
  { key: "Off-hours", value: "Six raised beds, a hydroponic tower, half marathons, and Purdue basketball." },
];
---

<Desktop windowTitle="Welcome to the garden" current="home">
  <section class="intro">
    <div class="intro__copy">
      <img class="intro__avatar" src="/avatar.png" alt="Adam Gardner" width="88" height="88" />
      <p class="kicker">Director of Product at Backstroke</p>
      <h1>Adam Gardner</h1>
      <p class="lede">
        One foot in product leadership; the other in the IDE, learning to code with Claude and Codex and
        getting scrappy alongside the engineers.
      </p>
      <div class="intro__actions">
        <a class="btn" href="/work/">See the work</a>
        <a class="btn btn--plain" href="/garden/">Walk the project map</a>
      </div>
    </div>
    <ul class="stakes">
      {stakes.map((s, i) => (
        <li class="stake" style={`--tilt:${[-1.5, 1, -0.5][i]}deg`}>
          <span class="stake__key">{s.key}</span>
          <span class="stake__val">{s.value}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="season">
    <div class="block__head">
      <h2 id="season">In season</h2>
      <a href="/work/">All {work.length} projects</a>
    </div>
    <ul class="packets">
      {featured.map((entry) => (
        <li><SeedPacket entry={entry} /></li>
      ))}
    </ul>
  </section>

  <section class="block" id="kind-words" aria-labelledby="kind-words-h">
    <div class="block__head">
      <h2 id="kind-words-h">Kind words</h2>
      <p class="block__sub">From people I've built with.</p>
    </div>
    <div class="notes">
      {testimonials.map((t, i) => (
        <figure class="sticky" style={`--tint:${noteTints[i % noteTints.length]};--tilt:${[-1.2, 0.8, -0.4, 1.3, -0.9, 0.5, -1.4][i % 7]}deg`}>
          <blockquote>{t.data.quote}</blockquote>
          <figcaption>{t.data.author ? `${t.data.author}, ` : ""}{t.data.role}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="block lately" aria-labelledby="lately">
    <div class="lately__copy">
      <h2 id="lately">Watering log</h2>
      <p class="lede">
        I'm a PM who's always built close to the metal. The last year is the first time I've shipped production code,
        with Claude Code as a partner, after a decade of leaving the IDE to engineers. The work is faster, the prototypes
        are real, and the conversations with engineers are sharper for it.
      </p>
    </div>
    <WateringLog />
  </section>
</Desktop>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .intro__avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    border: 1.5px solid var(--color-kale);
    box-shadow: 0 0 0 5px var(--color-chard);
    margin-bottom: 1.25rem;
  }

  .intro h1 {
    margin: 0.35rem 0 1rem;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    font-weight: 800;
    font-variation-settings: "opsz" 96, "wdth" 82;
    letter-spacing: -0.035em;
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .stakes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .stake {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 1.25rem 0.9rem;
    background: #e9d3b0;
    border: 1.5px solid var(--color-kale);
    border-radius: 4px;
    transform: rotate(var(--tilt));
    box-shadow: 0 3px 0 var(--color-cedar-dark);
  }

  .stake::before,
  .stake::after {
    content: "";
    position: absolute;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-cedar-dark);
  }

  .stake::before {
    left: 0.5rem;
  }

  .stake::after {
    right: 0.5rem;
  }

  .stake__key {
    font-weight: 750;
    font-size: 0.85rem;
    color: var(--color-cedar-dark);
  }

  .stake__val {
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .block {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .block__head h2 {
    margin: 0;
  }

  .block__head a {
    font-weight: 600;
  }

  .block__sub {
    margin: 0;
    color: var(--color-kale-soft);
  }

  .packets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem 1.25rem;
  }

  .notes {
    columns: 3 250px;
    column-gap: 1.25rem;
  }

  .sticky {
    break-inside: avoid;
    margin: 0 0 1.25rem;
    padding: 1.1rem 1.15rem 1rem;
    background: var(--tint);
    border: 1.5px solid var(--color-kale);
    border-radius: 3px;
    transform: rotate(var(--tilt));
    box-shadow: 0 10px 18px -12px rgb(30 43 27 / 0.6);
  }

  .sticky blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    font-variation-settings: "opsz" 14, "SOFT" 60;
  }

  .sticky figcaption {
    margin-top: 0.85rem;
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--color-kale-soft);
  }

  .lately {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .lately__copy h2 {
    margin-top: 0;
  }

  .lately .lede {
    font-size: 1.1rem;
  }

  @media (max-width: 860px) {
    .intro,
    .lately {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stake,
    .sticky {
      transform: none;
    }
  }
</style>
