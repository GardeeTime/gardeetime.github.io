---
import { getCollection } from "astro:content";
import Desktop from "../../layouts/Desktop.astro";
import SeedPacket from "../../components/garden/SeedPacket.astro";

const work = (await getCollection("work")).sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
const companies = [...new Set(work.map((e) => e.data.company.replace(/\s*\(.*\)/, "")))];
const counts = Object.fromEntries(companies.map((c) => [c, work.filter((e) => e.data.company.startsWith(c)).length]));
---

<Desktop title="Work — Adam Gardner" windowTitle={`Seed packets — ${work.length} projects`} current="work">
  <header class="head">
    <h1>Seed packets</h1>
    <p class="lede">
      Every project I've planted since 2017, newest first: what I built, the bets I made, and what came up.
      Pick a packet to read how it grew.
    </p>
  </header>

  <div class="filters" role="group" aria-label="Filter by company" data-filters>
    <button type="button" class="chip" aria-pressed="true" data-filter="all">All <span>{work.length}</span></button>
    {companies.map((c) => (
      <button type="button" class="chip" aria-pressed="false" data-filter={c}>{c} <span>{counts[c]}</span></button>
    ))}
  </div>

  <ul class="rack" data-rack>
    {work.map((entry) => (
      <li data-company={entry.data.company.replace(/\s*\(.*\)/, "")}><SeedPacket entry={entry} headingLevel="h2" /></li>
    ))}
  </ul>
  <p class="visually-hidden" aria-live="polite" data-filter-status></p>
</Desktop>

<style>
  .head h1 {
    margin: 0 0 0.75rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 1.75rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1.5px solid var(--color-kale);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-kale);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .chip span {
    font-weight: 500;
    color: var(--color-kale-faint);
    font-variant-numeric: tabular-nums;
  }

  .chip:hover {
    background: var(--color-chard);
  }

  .chip[aria-pressed="true"] {
    background: var(--color-kale);
    color: var(--color-paper);
  }

  .chip[aria-pressed="true"] span {
    color: var(--color-chard-deep);
  }

  .rack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem 1.25rem;
  }

  .rack li[hidden] {
    display: none;
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>("[data-filters]")!;
  const items = [...document.querySelectorAll<HTMLLIElement>("[data-rack] > li")];
  const status = document.querySelector<HTMLElement>("[data-filter-status]")!;
  group.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
    if (!btn) return;
    const f = btn.dataset.filter!;
    group.querySelectorAll("[data-filter]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    let shown = 0;
    for (const li of items) {
      li.hidden = f !== "all" && li.dataset.company !== f;
      if (!li.hidden) shown++;
    }
    status.textContent = `Showing ${shown} projects`;
  });
</script>
