---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Desktop from "../../layouts/Desktop.astro";
import { veggieFor, STATUS_LABEL } from "../../components/garden/veggies";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: work } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const v = veggieFor(entry.id);

const fmt = (s: string) => {
  const [y, m] = s.split("-");
  return new Date(Number(y), Number(m) - 1).toLocaleString("en-US", { month: "long", year: "numeric" });
};
const short = (t: string) => t.split(" — ")[0];
const byId = new Map(all.map((e) => [e.id, e]));
const grewFrom = d.grewFrom.map((id) => byId.get(id)).filter((e) => e !== undefined);
const ledTo = all.filter((e) => e.data.grewFrom.includes(entry.id));

const sorted = [...all].sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
const i = sorted.findIndex((e) => e.id === entry.id);
const newer = sorted[i - 1];
const older = sorted[i + 1];
---

<Desktop title={`${short(d.title)} — Adam Gardner`} description={d.summary} windowTitle={`${short(d.title)} — Seed packets`} current="work">
  <a class="back" href="/work/">All seed packets</a>

  <header class="head">
    <div class="head__badge" style={`--tint:${v.tint}`}>
      <svg viewBox="0 0 48 48" width="56" height="56" aria-hidden="true" set:html={v.svg} />
    </div>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
  </header>

  <dl class="back-label" style={`--tint:${v.tint}`}>
    <div><dt>Grown at</dt><dd>{d.company}</dd></div>
    <div><dt>Role</dt><dd>{d.role ?? "Product"}</dd></div>
    <div><dt>Sown</dt><dd>{fmt(d.startDate)}{d.endDate && ` to ${fmt(d.endDate)}`}</dd></div>
    <div><dt>Status</dt><dd>{STATUS_LABEL[d.status] ?? d.status}</dd></div>
    <div class="back-label__wide"><dt>Grows well with</dt><dd>{d.tags.filter((t) => t.toLowerCase() !== "shipped").join(", ")}</dd></div>
    {grewFrom.length > 0 && (
      <div class="back-label__wide"><dt>Grew out of</dt><dd>{grewFrom.map((e, k) => <>{k > 0 && ", "}<a href={`/work/${e!.id}/`}>{short(e!.data.title)}</a></>)}</dd></div>
    )}
    {ledTo.length > 0 && (
      <div class="back-label__wide"><dt>Led to</dt><dd>{ledTo.map((e, k) => <>{k > 0 && ", "}<a href={`/work/${e.id}/`}>{short(e.data.title)}</a></>)}</dd></div>
    )}
  </dl>

  {d.links.length > 0 && (
    <ul class="links">
      {d.links.map((l) => (
        <li><a class="btn btn--plain btn--small" href={l.url} target="_blank" rel="noreferrer noopener">{l.label}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      ))}
    </ul>
  )}

  {d.heroImage && (
    <figure class="hero" style={`view-transition-name: art-${entry.id}`}>
      <Image src={d.heroImage} alt={d.heroImageAlt ?? ""} widths={[480, 800, 1200]} sizes="(min-width: 1100px) 860px, 94vw" />
    </figure>
  )}

  <div class="prose body">
    <Content />
  </div>

  <nav class="pager" aria-label="More projects">
    {newer ? <a href={`/work/${newer.id}/`}><span>Newer</span>{short(newer.data.title)}</a> : <span />}
    {older && <a class="pager__older" href={`/work/${older.id}/`}><span>Older</span>{short(older.data.title)}</a>}
  </nav>
</Desktop>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .back::before {
    content: "\2190\00a0";
  }

  .head {
    max-width: 52rem;
  }

  .head__badge {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: var(--tint);
    border: 1.5px solid var(--color-kale);
    box-shadow: 0 3px 0 var(--color-kale);
  }

  .head h1 {
    margin: 0 0 1rem;
  }

  .back-label {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 2.25rem 0 1.5rem;
    background: var(--tint);
    border: 1.5px solid var(--color-kale);
    border-radius: 6px;
    overflow: hidden;
  }

  .back-label > div {
    padding: 0.75rem 1rem;
    border-right: 1.5px dashed rgb(30 43 27 / 0.4);
    border-bottom: 1.5px dashed rgb(30 43 27 / 0.4);
  }

  .back-label__wide {
    grid-column: 1 / -1;
  }

  .back-label dt {
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--color-kale-soft);
  }

  .back-label dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }

  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0 0 2.25rem;
    padding: 0;
  }

  .hero {
    margin: 0 0 2.5rem;
    border: 1.5px solid var(--color-kale);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 0 rgb(30 43 27 / 0.85);
  }

  .hero img {
    display: block;
    width: 100%;
  }

  .body {
    margin-inline: auto;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
  }

  .pager a {
    display: grid;
    gap: 0.15rem;
    max-width: 45%;
    padding: 0.8rem 1rem;
    border: 1.5px solid var(--color-kale);
    border-radius: 9px;
    background: var(--color-chard);
    color: var(--color-kale);
    font-weight: 650;
    text-decoration: none;
  }

  .pager a:hover {
    background: var(--color-chard-deep);
  }

  .pager span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-kale-soft);
  }

  .pager__older {
    text-align: right;
  }

  @media (max-width: 700px) {
    .back-label {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
