---
import { getCollection } from "astro:content";
import Desktop from "../layouts/Desktop.astro";
import { veggieFor } from "../components/garden/veggies";

const shipped = (await getCollection("work"))
  .filter((e) => e.data.status === "shipped")
  .sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));

const years = [...new Set(shipped.map((e) => e.data.startDate.slice(0, 4)))];
const monthName = (s: string) => {
  const [y, m] = s.split("-");
  return new Date(Number(y), Number(m) - 1).toLocaleString("en-US", { month: "short" });
};
---

<Desktop title="Harvest log — Adam Gardner" windowTitle="Harvest log — everything shipped" current="harvest">
  <header class="head">
    <h1>Harvest log</h1>
    <p class="lede">
      {shipped.length} projects that made it all the way to customers, by the month they were planted. Prototypes that
      didn't ship are in the <a href="/compost/">compost bin</a>.
    </p>
  </header>

  {years.map((y) => {
    const rows = shipped.filter((e) => e.data.startDate.startsWith(y));
    return (
      <section class="year" aria-labelledby={`y-${y}`}>
        <h2 id={`y-${y}`}>{y} <span>{rows.length} harvested</span></h2>
        <ol class="rows">
          {rows.map((e) => (
            <li class="row">
              <span class="row__month">{monthName(e.data.startDate)}</span>
              <svg class="row__veg" viewBox="0 0 48 48" width="34" height="34" aria-hidden="true" set:html={veggieFor(e.id).svg} />
              <div class="row__main">
                <a href={`/work/${e.id}/`}>{e.data.title.split(" — ")[0]}</a>
                <span class="row__co">{e.data.company.replace(/\s*\(.*\)/, "")}</span>
                <p>{e.data.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    );
  })}
</Desktop>

<style>
  .head h1 {
    margin: 0 0 1rem;
  }

  .year {
    margin-top: 3rem;
  }

  .year h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid var(--color-kale);
  }

  .year h2 span {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-leaf);
    letter-spacing: 0;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 3rem 40px minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 0.9rem 0;
    border-bottom: 1.5px dashed var(--color-chard-deep);
  }

  .row__month {
    padding-top: 0.2rem;
    font-weight: 650;
    color: var(--color-kale-soft);
  }

  .row__main a {
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--color-kale);
  }

  .row__co {
    margin-left: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-leaf);
  }

  .row__main p {
    margin: 0.3rem 0 0;
    color: var(--color-kale-soft);
    max-width: 72ch;
    font-size: 0.95rem;
  }
</style>
