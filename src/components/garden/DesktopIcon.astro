---
// Desktop icons drawn on a 56×56 grid. Same outline weight as the veggie glyphs.
interface Props {
  name: "welcome" | "seeds" | "beds" | "greenhouse" | "harvest" | "almanac" | "notes" | "shed" | "compost";
  label: string;
  href: string;
  external?: boolean;
  current?: boolean;
}

const { name, label, href, external = false, current = false } = Astro.props;
const O = `stroke="#1e2b1b" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"`;

const art: Record<Props["name"], string> = {
  welcome: `<path d="M14 30h28l-3 18H17z" fill="#c8693a" ${O}/><path d="M12 26h32v6H12z" fill="#d97a45" ${O}/>
    <path d="M28 26c0-7-3-12-9-14 0 7 3 11 9 14zM28 26c0-6 3-11 10-12-1 6-4 10-10 12z" fill="#8dbf56" ${O}/><path d="M28 26V16" ${O}/>`,
  seeds: `<path d="M13 8h30v40H13z" fill="#fbe6b0" ${O}/><path d="M13 15h30" ${O} stroke-dasharray="3 3"/>
    <rect x="18" y="20" width="20" height="16" rx="3" fill="#f6d3c8" ${O}/><circle cx="28" cy="28" r="5" fill="#d8432a" ${O}/>
    <path d="M18 41h20" ${O}/>`,
  beds: `<rect x="6" y="12" width="44" height="32" rx="2" fill="#a87c55" ${O}/><rect x="11" y="17" width="34" height="22" fill="#4a3527" ${O}/>
    <circle cx="18" cy="23" r="3.5" fill="#8dbf56" ${O}/><circle cx="28" cy="23" r="3.5" fill="#5f8f3b" ${O}/><circle cx="38" cy="23" r="3.5" fill="#8dbf56" ${O}/>
    <circle cx="18" cy="33" r="3.5" fill="#5f8f3b" ${O}/><circle cx="28" cy="33" r="3.5" fill="#d8432a" ${O}/><circle cx="38" cy="33" r="3.5" fill="#5f8f3b" ${O}/>`,
  greenhouse: `<path d="M8 26 28 10l20 16v20H8z" fill="#dff1f4" ${O}/><path d="M28 10v36M8 26h40M18 18v28M38 18v28M8 36h40" ${O} fill="none" stroke-opacity=".6"/>
    <path d="M24 46V36h8v10" fill="#8dbf56" ${O}/>`,
  harvest: `<path d="M9 26h38l-5 20H14z" fill="#c9965f" ${O}/><path d="M14 26c0-10 28-10 28 0" fill="none" ${O}/>
    <circle cx="20" cy="24" r="6" fill="#d8432a" ${O}/><circle cx="31" cy="23" r="6" fill="#f3b63f" ${O}/><path d="M36 26c2-6 6-8 9-8-1 5-4 8-9 8z" fill="#8dbf56" ${O}/>
    <path d="M14 34h28M16 40h24" ${O} stroke-opacity=".5"/>`,
  almanac: `<path d="M10 12c6-2 12-2 18 2v34c-6-4-12-4-18-2z" fill="#f8faf1" ${O}/><path d="M46 12c-6-2-12-2-18 2v34c6-4 12-4 18-2z" fill="#f8faf1" ${O}/>
    <path d="M14 20c3-1 7-1 10 1M14 26c3-1 7-1 10 1M32 21c3-2 7-2 10-1" fill="none" ${O} stroke-opacity=".5"/><circle cx="37" cy="31" r="4" fill="#f3b63f" ${O}/>`,
  notes: `<path d="M10 22c0-8 6-12 12-12h14c7 0 10 5 10 12v14H10z" fill="#5f8f3b" ${O}/><path d="M22 10c6 0 10 5 10 12v14" fill="none" ${O}/>
    <rect x="13" y="24" width="14" height="9" rx="1" fill="#fbe6b0" ${O}/><path d="M26 36v12" ${O}/><path d="M38 18v-8h8v5h-8" fill="#d8432a" ${O}/>`,
  shed: `<path d="M8 24 28 10l20 14" fill="none" ${O}/><path d="M12 22v24h32V22" fill="#a87c55" ${O}/><path d="M22 46V32h12v14" fill="#6f4f33" ${O}/>
    <path d="M17 30h-2M41 30h-2" ${O}/><path d="M6 25l22-16 22 16" fill="none" stroke="#d8432a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>`,
  compost: `<path d="M12 18h32l-3 30H15z" fill="#5f8f3b" ${O}/><path d="M10 12h36v6H10z" fill="#3f6b2a" ${O}/>
    <path d="M21 26c4-4 10-1 9 3-1 5-8 2-6-2M28 38c-3 2-7 1-7-2" fill="none" stroke="#dfe8c9" stroke-width="2" stroke-linecap="round"/><path d="M24 12V8h8v4" fill="none" ${O}/>`,
};
---

<a
  class="dicon"
  href={href}
  aria-current={current ? "page" : undefined}
  {...(external ? { target: "_blank", rel: "noreferrer noopener" } : {})}
>
  <svg class="dicon__art" viewBox="0 0 56 56" width="52" height="52" aria-hidden="true" focusable="false" set:html={art[name]} />
  <span class="dicon__label">{label}</span>
</a>

<style>
  .dicon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 92px;
    padding: 0.4rem 0.25rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-kale);
  }

  .dicon__art {
    filter: drop-shadow(0 2px 0 rgb(30 43 27 / 0.35));
    transform-origin: 50% 90%;
  }

  .dicon__label {
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
    background: rgb(248 250 241 / 0.92);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    box-shadow: 0 1px 0 rgb(30 43 27 / 0.25);
  }

  .dicon:hover .dicon__art,
  .dicon:focus-visible .dicon__art {
    animation: sway 700ms ease-in-out;
  }

  .dicon[aria-current="page"] .dicon__label {
    background: var(--color-kale);
    color: var(--color-paper);
  }

  @keyframes sway {
    0%, 100% { transform: rotate(0); }
    30% { transform: rotate(-6deg); }
    65% { transform: rotate(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dicon:hover .dicon__art,
    .dicon:focus-visible .dicon__art {
      animation: none;
    }
  }
</style>
