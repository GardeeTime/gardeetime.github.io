---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { veggieFor, STATUS_LABEL } from "./veggies";

interface Props {
  entry: CollectionEntry<"work">;
  headingLevel?: "h2" | "h3";
}

const { entry, headingLevel = "h3" } = Astro.props;
const d = entry.data;
const v = veggieFor(entry.id);
const [y, m] = d.startDate.split("-");
const sown = new Date(Number(y), Number(m) - 1).toLocaleString("en-US", { month: "short", year: "numeric" });
const Heading = headingLevel;
const company = d.company.replace(/\s*\(.*\)/, "");
---

<article class="packet" style={`--tint:${v.tint}`} data-company={company}>
  <a class="packet__link" href={`/work/${entry.id}/`}>
    <div class="packet__flap">
      <span>{company}</span>
      <span>Sown {sown}</span>
    </div>
    <div class="packet__window" style={`view-transition-name: art-${entry.id}`}>
      {d.heroImage
        ? <Image src={d.heroImage} alt="" widths={[360, 640]} sizes="(min-width: 1100px) 300px, 90vw" />
        : <svg class="packet__veggie" viewBox="0 0 48 48" aria-hidden="true" set:html={v.svg} />}
      <span class="packet__badge" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="34" height="34" set:html={v.svg} />
      </span>
    </div>
    <Heading class="packet__title">{d.title.split(" — ")[0]}</Heading>
    <p class="packet__summary">{d.summary}</p>
    <p class="packet__status" data-status={d.status}>{STATUS_LABEL[d.status] ?? d.status}</p>
  </a>
</article>

<style>
  .packet {
    position: relative;
    height: 100%;
  }

  .packet__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0 0.9rem 1rem;
    background: var(--tint);
    border: 1.5px solid var(--color-kale);
    border-radius: 4px 4px 10px 10px;
    color: var(--color-kale);
    text-decoration: none;
    box-shadow: 0 3px 0 rgb(30 43 27 / 0.85);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .packet__link:hover {
    color: var(--color-kale);
    transform: translateY(-4px) rotate(-0.6deg);
    box-shadow: 0 8px 0 rgb(30 43 27 / 0.85);
  }

  .packet__flap {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-inline: -0.9rem;
    padding: 0.55rem 0.9rem 0.5rem;
    border-bottom: 1.5px dashed rgb(30 43 27 / 0.55);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-kale-soft);
    font-variant-numeric: tabular-nums;
  }

  .packet__window {
    position: relative;
    margin-top: 0.9rem;
    aspect-ratio: 16 / 10;
    border: 1.5px solid var(--color-kale);
    border-radius: 10px;
    background: var(--color-paper);
    overflow: hidden;
  }

  .packet__window img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .packet__veggie {
    width: 100%;
    height: 100%;
    padding: 14%;
  }

  .packet__badge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--tint);
    border: 1.5px solid var(--color-kale);
  }

  .packet__title {
    margin: 0.9rem 0 0.4rem;
    font-size: 1.2rem;
    font-weight: 700;
    font-variation-settings: "opsz" 24, "wdth" 92;
    line-height: 1.15;
  }

  .packet__summary {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-kale-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .packet__status {
    align-self: flex-start;
    margin: auto 0 0;
    padding-top: 0.9rem;
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--color-leaf);
  }

  .packet__status::before {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.4em;
    border-radius: 50% 0;
    background: currentColor;
    transform: rotate(-20deg);
  }

  .packet__status[data-status="poc"],
  .packet__status[data-status="concept"] {
    color: var(--color-beet);
  }

  @media (prefers-reduced-motion: reduce) {
    .packet__link,
    .packet__link:hover {
      transition: none;
      transform: none;
    }
  }
</style>
