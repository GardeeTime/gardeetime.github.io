---
const username = Astro.props.username ?? "GardeeTime";

interface Cell {
  date: string;
  level: number;
}

interface WeekColumn {
  cells: Cell[];
}

let weeks: WeekColumn[] = [];
let total: number | null = null;
let fetchOk = false;

try {
  const res = await fetch(`https://github.com/users/${username}/contributions`, {
    headers: { "User-Agent": "gardeetime-site/1.0" },
  });
  if (res.ok) {
    const html = await res.text();

    // Extract all day cells: <td ... data-date="YYYY-MM-DD" ... data-level="N" ...>
    const cellRegex = /<td[^>]*data-date="(\d{4}-\d{2}-\d{2})"[^>]*data-level="(\d)"[^>]*>/g;
    const cells: Cell[] = [];
    let m: RegExpExecArray | null;
    while ((m = cellRegex.exec(html))) {
      cells.push({ date: m[1], level: parseInt(m[2], 10) });
    }

    // GitHub orders cells by week column then by day-of-week within each column.
    // We can group by week using the date — Sunday-aligned columns.
    if (cells.length > 0) {
      cells.sort((a, b) => a.date.localeCompare(b.date));

      const byWeek = new Map<string, Cell[]>();
      for (const c of cells) {
        const d = new Date(c.date + "T00:00:00Z");
        const day = d.getUTCDay(); // 0 = Sunday
        const sunday = new Date(d);
        sunday.setUTCDate(d.getUTCDate() - day);
        const wkKey = sunday.toISOString().slice(0, 10);
        const list = byWeek.get(wkKey) ?? [];
        list.push(c);
        byWeek.set(wkKey, list);
      }
      const sortedKeys = Array.from(byWeek.keys()).sort();
      weeks = sortedKeys.map((k) => ({ cells: byWeek.get(k)! }));
    }

    const totalMatch = html.match(/([\d,]+)\s+contribution/);
    if (totalMatch) total = parseInt(totalMatch[1].replace(/,/g, ""), 10);

    fetchOk = cells.length > 0;
  }
} catch {
  fetchOk = false;
}

const cellSize = 11;
const cellGap = 3;
const weeksCount = weeks.length;
const width = Math.max(1, weeksCount) * (cellSize + cellGap);
const height = 7 * (cellSize + cellGap);
---

<div class="contribution-grid">
  <div class="contribution-grid__head">
    <p class="meta">
      {fetchOk
        ? `${total ?? "—"} contributions in the last year · @${username}`
        : `Activity refreshes when the site rebuilds`}
    </p>
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noreferrer noopener"
      class="contribution-grid__link"
      >GitHub →</a
    >
  </div>

  <div class="contribution-grid__scroll" data-contribution-scroll>
    {fetchOk ? (
      <svg
        viewBox={`0 0 ${width} ${height}`}
        width={width}
        height={height}
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label={`${total ?? "Recent"} GitHub contributions`}
      >
        {weeks.map((week, wi) =>
          week.cells.map((cell) => {
            const date = new Date(cell.date + "T00:00:00Z");
            const di = date.getUTCDay();
            return (
              <rect
                x={wi * (cellSize + cellGap)}
                y={di * (cellSize + cellGap)}
                width={cellSize}
                height={cellSize}
                rx={2}
                class:list={["contribution-cell", `level-${cell.level}`]}
                aria-label={`${cell.date}: level ${cell.level}`}
              />
            );
          })
        )}
      </svg>
    ) : (
      <div class="contribution-grid__placeholder" aria-hidden="true">
        {Array.from({ length: 53 * 7 }).map(() => <span />)}
      </div>
    )}
  </div>

  <div class="contribution-grid__legend">
    <span class="meta">Less</span>
    <span class="legend-cell level-0" aria-hidden="true"></span>
    <span class="legend-cell level-1" aria-hidden="true"></span>
    <span class="legend-cell level-2" aria-hidden="true"></span>
    <span class="legend-cell level-3" aria-hidden="true"></span>
    <span class="legend-cell level-4" aria-hidden="true"></span>
    <span class="meta">More</span>
  </div>
</div>

<style>
  .contribution-grid {
    width: 100%;
  }

  .contribution-grid__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.875rem;
    gap: 1rem;
  }

  .contribution-grid__link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    letter-spacing: 0.04em;
  }

  .contribution-grid__link:hover {
    color: var(--color-moss-glow);
  }

  .contribution-grid__scroll {
    overflow-x: auto;
    padding-block: 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .contribution-grid__scroll::-webkit-scrollbar {
    height: 6px;
  }

  .contribution-grid__scroll::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 3px;
  }

  .contribution-grid__placeholder {
    display: grid;
    grid-template-columns: repeat(53, 11px);
    grid-template-rows: repeat(7, 11px);
    gap: 3px;
    width: max-content;
  }

  .contribution-grid__placeholder span {
    background: var(--color-bg-elevated);
    border-radius: 2px;
  }

  .contribution-cell {
    fill: var(--color-bg-elevated);
    stroke: color-mix(in oklab, var(--color-border) 60%, transparent);
    stroke-width: 0.5;
    transition: fill 200ms ease;
  }

  .contribution-cell.level-1 {
    fill: color-mix(in oklab, var(--color-moss) 25%, var(--color-bg-elevated));
  }
  .contribution-cell.level-2 {
    fill: color-mix(in oklab, var(--color-moss) 50%, var(--color-bg-elevated));
  }
  .contribution-cell.level-3 {
    fill: color-mix(in oklab, var(--color-moss) 80%, var(--color-bg-elevated));
  }
  .contribution-cell.level-4 {
    fill: var(--color-moss-glow);
  }

  .contribution-grid__legend {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.875rem;
    justify-content: flex-end;
  }

  .legend-cell {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--color-bg-elevated);
  }

  .legend-cell.level-1 {
    background: color-mix(in oklab, var(--color-moss) 25%, var(--color-bg-elevated));
  }
  .legend-cell.level-2 {
    background: color-mix(in oklab, var(--color-moss) 50%, var(--color-bg-elevated));
  }
  .legend-cell.level-3 {
    background: color-mix(in oklab, var(--color-moss) 80%, var(--color-bg-elevated));
  }
  .legend-cell.level-4 {
    background: var(--color-moss-glow);
  }
</style>

<script>
  function scrollContributionsToLatest() {
    document.querySelectorAll<HTMLElement>("[data-contribution-scroll]").forEach((el) => {
      el.scrollLeft = el.scrollWidth;
    });
  }

  scrollContributionsToLatest();
  window.addEventListener("load", scrollContributionsToLatest);
  window.addEventListener("resize", scrollContributionsToLatest);
</script>
