---
const path = Astro.url.pathname;
const isHome = path === "/" || path === "";
const isWork = path.startsWith("/work");
const isAbout = path.startsWith("/about");
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Home">
      <span class="site-header__mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
          <!-- mycelium glyph: single Y-branch from a spore -->
          <circle cx="11" cy="18" r="1.4" fill="currentColor" />
          <path
            d="M11 17 C 11 14, 9 12.5, 8 10 M11 17 C 11 14, 13 12.5, 14 10 M8 10 C 7 8, 6.5 7, 5.5 5.5 M8 10 C 8.5 8, 8.6 7, 8.5 5.5 M14 10 C 14.5 8, 15 7, 15.8 5.5 M14 10 C 13.5 8, 13.4 7, 13.6 5.5"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="round"
            fill="none"
            opacity="0.85"
          />
        </svg>
      </span>
      <span class="site-header__name">Adam Gardner</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <a href="/" class:list={[isHome && "is-current"]}>Home</a>
      <a href="/work/" class:list={[isWork && "is-current"]}>Work</a>
      <a href="/about/" class:list={[isAbout && "is-current"]}>About</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 60%, transparent);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .site-header__brand:hover {
    color: var(--color-spore);
  }

  .site-header__mark {
    color: var(--color-moss);
    display: inline-flex;
  }

  .site-header__nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .site-header__nav a {
    color: var(--color-ink-muted);
    position: relative;
    padding-block: 0.25rem;
  }

  .site-header__nav a:hover {
    color: var(--color-ink);
  }

  .site-header__nav a.is-current {
    color: var(--color-moss-glow);
  }

  .site-header__nav a.is-current::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1px;
    background: var(--color-moss);
  }

  @media (max-width: 480px) {
    .site-header__nav {
      gap: 1rem;
    }
  }
</style>
