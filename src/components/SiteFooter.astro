---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide site-footer__inner">
    <div class="site-footer__col">
      <p class="meta">© {year} · Built by Adam &amp; Claude · Indianapolis, IN</p>
    </div>
    <div class="site-footer__col site-footer__links">
      <a href="https://github.com/GardeeTime" target="_blank" rel="noreferrer noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/adamgardner-97508353" target="_blank" rel="noreferrer noopener">LinkedIn</a>
      <a href="mailto:adamgardner32@gmail.com">Email</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-border);
    padding-block: 2rem;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .site-footer__links {
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .site-footer__links a {
    color: var(--color-ink-muted);
  }

  .site-footer__links a:hover {
    color: var(--color-moss-glow);
  }
</style>
