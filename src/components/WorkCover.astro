---
import { getImage } from "astro:assets";

interface Props {
  slug: string;
  title: string;
  company: string;
  status: "shipped" | "in-progress" | "poc" | "concept" | "ongoing";
  tags?: string[];
  ratio?: "wide" | "card";
  heroImage?: ImageMetadata;
}

const { slug, title, company, status, tags = [], ratio = "wide", heroImage } = Astro.props;

const treatedImageSrc = heroImage
  ? (await getImage({ src: heroImage, width: 1200, format: "webp" })).src
  : null;

interface MyStrand {
  d: string;
  len: number;
  delay: number;
}

function makeRng(seed: number): () => number {
  let s = seed >>> 0;
  return () => {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 0x100000000;
  };
}

function growStrand(
  startX: number,
  startY: number,
  direction: number,
  length: number,
  depth: number,
  rng: () => number,
  out: MyStrand[]
): void {
  if (depth > 2 || length < 14) return;
  const segs = Math.max(3, Math.round(length / 14));
  const segLen = length / segs;
  const pts: Array<[number, number]> = [[startX, startY]];
  let x = startX, y = startY, ang = direction, total = 0;
  for (let i = 0; i < segs; i++) {
    ang += (rng() - 0.5) * 0.32;
    const dx = Math.cos(ang) * segLen, dy = Math.sin(ang) * segLen;
    x += dx; y += dy;
    pts.push([x, y]);
    total += Math.hypot(dx, dy);
  }
  let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const cx = pts[i][0], cy = pts[i][1];
    const mx = (cx + pts[i + 1][0]) / 2, my = (cy + pts[i + 1][1]) / 2;
    d += `Q${cx.toFixed(1)},${cy.toFixed(1)} ${mx.toFixed(1)},${my.toFixed(1)}`;
  }
  d += `T${pts[pts.length - 1][0].toFixed(1)},${pts[pts.length - 1][1].toFixed(1)}`;
  out.push({ d, len: Math.ceil(total), delay: depth * 0.18 + rng() * 0.18 });

  const tipAng = Math.atan2(pts[pts.length - 1][1] - pts[pts.length - 2][1], pts[pts.length - 1][0] - pts[pts.length - 2][0]);
  if (rng() < 0.85 - depth * 0.2) {
    const sign = rng() < 0.5 ? -1 : 1;
    growStrand(x, y, tipAng + (0.35 + rng() * 0.3) * sign, length * (0.55 + rng() * 0.18), depth + 1, rng, out);
  }
  if (depth === 0 && rng() < 0.6) {
    const sign = rng() < 0.5 ? -1 : 1;
    growStrand(x, y, tipAng + (0.55 + rng() * 0.3) * -sign, length * (0.5 + rng() * 0.18), depth + 1, rng, out);
  }
}

const myRng = makeRng((typeof slug === "string" ? slug : "x").split("").reduce((a, c) => (a * 33) ^ c.charCodeAt(0), 5381) >>> 0);
const strands: MyStrand[] = [];
const roots: Array<[number, number, number, number]> = [
  [0, 90 + myRng() * 80, 0.05 + myRng() * 0.35, 140 + myRng() * 50],
  [600, 90 + myRng() * 80, Math.PI - 0.05 - myRng() * 0.35, 140 + myRng() * 50],
  [120 + myRng() * 360, 0, Math.PI / 2 - 0.2 + myRng() * 0.4, 110 + myRng() * 40],
  [120 + myRng() * 360, 360, -Math.PI / 2 + 0.2 - myRng() * 0.4, 110 + myRng() * 40],
];
for (const [rx, ry, dir, len] of roots) growStrand(rx, ry, dir, len, 0, myRng, strands);
const sporeCount = 3;
const spores: Array<[number, number, number]> = [];
for (let i = 0; i < sporeCount; i++) {
  spores.push([60 + myRng() * 480, 50 + myRng() * 260, 0.6 + myRng() * 0.6]);
}

function hash(s: string) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const h = hash(slug);
const angle = h % 360;
const hotX = 20 + (h >> 4) % 60;
const hotY = 25 + (h >> 9) % 50;
const patternVariant = (h >> 13) % 4;
const accentShift = ((h >> 17) % 24) - 12;

const statusColor: Record<string, string> = {
  shipped: "var(--color-moss-glow)",
  "in-progress": "var(--color-spore)",
  poc: "#d99a6c",
  concept: "var(--color-ink-muted)",
  ongoing: "var(--color-moss)",
};
const accent = statusColor[status] ?? "var(--color-moss)";

const initials = company
  .replace(/\(.*?\)/g, "")
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .join("");

const isAi = tags.some((t) => /ai/i.test(t));
const isEng = tags.some((t) => /eng/i.test(t));

const viewBox = ratio === "card" ? "0 0 600 360" : "0 0 600 280";
const gradId = `grad-${slug.replace(/[^a-z0-9]/gi, "")}-${h % 9999}`;
const accentGradId = `accent-${slug.replace(/[^a-z0-9]/gi, "")}-${h % 9999}`;
---

<figure class="work-cover" data-status={status}>
  <svg viewBox={viewBox} xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${title} cover`}>
    <defs>
      <radialGradient id={gradId} cx={`${hotX}%`} cy={`${hotY}%`} r="85%">
        <stop offset="0%" stop-color="var(--color-bg-card)" stop-opacity="1" />
        <stop offset="55%" stop-color="var(--color-bg-elevated)" stop-opacity="1" />
        <stop offset="100%" stop-color="var(--color-bg)" stop-opacity="1" />
      </radialGradient>
      <linearGradient id={accentGradId} x1="0" y1="0" x2="1" y2="1" gradientTransform={`rotate(${angle} 0.5 0.5)`}>
        <stop offset="0%" stop-color={accent} stop-opacity="0.28" />
        <stop offset="100%" stop-color={accent} stop-opacity="0" />
      </linearGradient>
    </defs>

    {!treatedImageSrc && <rect width="600" height="360" fill={`url(#${gradId})`} />}

    {treatedImageSrc && (
      <>
        <defs>
          <filter id={`duotone-${slug.replace(/[^a-z0-9]/gi, "")}`} color-interpolation-filters="sRGB">
            <feColorMatrix
              type="matrix"
              values="0.299 0.587 0.114 0 0
                      0.299 0.587 0.114 0 0
                      0.299 0.587 0.114 0 0
                      0 0 0 1 0"
            />
            <feComponentTransfer>
              <feFuncR tableValues="0.025 0.72" />
              <feFuncG tableValues="0.03 0.7" />
              <feFuncB tableValues="0.025 0.5" />
            </feComponentTransfer>
          </filter>
          <linearGradient id={`darken-${slug.replace(/[^a-z0-9]/gi, "")}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--color-bg)" stop-opacity="0.4" />
            <stop offset="55%" stop-color="var(--color-bg)" stop-opacity="0.65" />
            <stop offset="100%" stop-color="var(--color-bg)" stop-opacity="0.95" />
          </linearGradient>
        </defs>
        <image
          href={treatedImageSrc}
          x="0"
          y="0"
          width="600"
          height="360"
          preserveAspectRatio="xMidYMid slice"
          filter={`url(#duotone-${slug.replace(/[^a-z0-9]/gi, "")})`}
          opacity="0.78"
        />
        <rect width="600" height="360" fill={`url(#darken-${slug.replace(/[^a-z0-9]/gi, "")})`} />
      </>
    )}

    <rect width="600" height="360" fill={`url(#${accentGradId})`} opacity={treatedImageSrc ? 0.7 : 1} />

    {!treatedImageSrc && patternVariant === 0 && (
      <g class="cover-pattern" stroke={accent} stroke-width="0.6" fill="none" opacity="0.32">
        {Array.from({ length: 9 }, (_, i) => (
          <line x1={-50 + i * 80} y1="0" x2={50 + i * 80 - 80} y2="360" />
        ))}
      </g>
    )}

    {!treatedImageSrc && patternVariant === 1 && (
      <g class="cover-pattern" fill={accent} opacity="0.28">
        {Array.from({ length: 36 }, (_, i) => {
          const x = (i % 9) * 70 + 30;
          const y = Math.floor(i / 9) * 80 + 40;
          const r = 1 + ((h >> (i % 16)) & 3) * 0.6;
          return <circle cx={x} cy={y} r={r} />;
        })}
      </g>
    )}

    {!treatedImageSrc && patternVariant === 2 && (
      <g class="cover-pattern" stroke={accent} stroke-width="0.5" fill="none" opacity="0.34">
        {Array.from({ length: 6 }, (_, i) => (
          <path d={`M 0 ${60 + i * 50} Q 150 ${20 + (i * 70) % 240} 300 ${100 + (i * 40) % 220} T 600 ${80 + (i * 60) % 240}`} />
        ))}
      </g>
    )}

    {!treatedImageSrc && patternVariant === 3 && (
      <g class="cover-pattern" stroke={accent} stroke-width="0.5" fill="none" opacity="0.3">
        <path d="M 50 300 L 150 180 L 250 220 L 360 100 L 470 200 L 580 80" />
        <path d="M 50 320 L 150 200 L 250 240 L 360 120 L 470 220 L 580 100" />
        {Array.from({ length: 6 }, (_, i) => {
          const xs = [50, 150, 250, 360, 470, 580];
          const ys = [300, 180, 220, 100, 200, 80];
          return <circle cx={xs[i]} cy={ys[i]} r="3" fill={accent} />;
        })}
      </g>
    )}

    {isAi && (
      <g class="cover-glyph" stroke={accent} stroke-width="0.7" fill="none" opacity="0.5" transform="translate(480 60)">
        <circle cx="0" cy="0" r="3" fill={accent} stroke="none" />
        <path d="M 0 0 C -8 -10, -22 -14, -32 -8" />
        <path d="M 0 0 C 8 -10, 22 -14, 32 -8" />
        <path d="M -32 -8 C -38 -16, -38 -24, -34 -32" />
        <path d="M 32 -8 C 38 -16, 38 -24, 34 -32" />
      </g>
    )}

    <g class="cover-mycelium" stroke={accent} stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" fill="none">
      {strands.map((s) => (
        <path d={s.d} style={`--len:${s.len};--delay:${s.delay.toFixed(2)}s`} />
      ))}
    </g>
    <g class="cover-mycelium-spores" fill={accent}>
      {spores.map(([sx, sy, sr], i) => (
        <circle cx={sx.toFixed(1)} cy={sy.toFixed(1)} r={sr.toFixed(2)} style={`--delay:${(0.5 + i * 0.12).toFixed(2)}s`} />
      ))}
    </g>

    <text x="540" y="48" text-anchor="end" class="cover-status" fill={accent}>{status.toUpperCase()}</text>
  </svg>
</figure>

<style>
  .work-cover {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-bg-elevated);
    aspect-ratio: 600 / 280;
  }

  .work-cover svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover-status {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    opacity: 0.72;
  }

  .cover-mycelium path {
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    opacity: 0;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.35, 0, 0.25, 1), opacity 0.4s ease;
    transition-delay: var(--delay);
  }

  .cover-mycelium-spores circle {
    opacity: 0;
    transform-origin: center;
    transform: scale(0.4);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: var(--delay);
  }

  :global(.work-item__link:hover) .cover-mycelium path,
  :global(.featured-item:hover) .cover-mycelium path,
  :global(.work-item__link:focus-visible) .cover-mycelium path,
  :global(.featured-item:focus-visible) .cover-mycelium path {
    stroke-dashoffset: 0;
    opacity: 0.55;
  }

  :global(.work-item__link:hover) .cover-mycelium-spores circle,
  :global(.featured-item:hover) .cover-mycelium-spores circle,
  :global(.work-item__link:focus-visible) .cover-mycelium-spores circle,
  :global(.featured-item:focus-visible) .cover-mycelium-spores circle {
    opacity: 0.7;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-mycelium path,
    .cover-mycelium-spores circle {
      transition: none;
    }
  }
</style>
