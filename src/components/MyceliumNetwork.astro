---
/*
 * Procedural mycelium network.
 * Renders at build time as SVG paths. Animates via stroke-dashoffset on first paint.
 *
 * Real mycelium characteristics encoded:
 *  - Acute, irregular Y-branching (not 60° / 90° trees)
 *  - Tip growth (each strand spawns 1-3 children at its end)
 *  - Decreasing branch probability with depth (network thins at edges)
 *  - Slight per-segment wobble (no perfectly straight strands)
 *  - No loops or self-intersections (pure recursion outward)
 */

interface Strand {
  d: string;
  approxLength: number;
  delay: number;
  opacity: number;
  width: number;
}

interface Pt {
  x: number;
  y: number;
}

function makeRng(seed: number): () => number {
  let s = seed >>> 0;
  return () => {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 0x100000000;
  };
}

function grow(
  start: Pt,
  direction: number,
  length: number,
  depth: number,
  rng: () => number,
  strands: Strand[],
  bounds: { w: number; h: number }
): void {
  if (depth > 5) return;
  if (length < 8) return;

  const segments = Math.max(4, Math.round(length / 9));
  const segLen = length / segments;
  const points: Pt[] = [start];
  let angle = direction;
  let { x, y } = start;
  let totalLen = 0;

  for (let i = 0; i < segments; i++) {
    angle += (rng() - 0.5) * 0.28;
    const dx = Math.cos(angle) * segLen;
    const dy = Math.sin(angle) * segLen;
    x += dx;
    y += dy;
    points.push({ x, y });
    totalLen += Math.hypot(dx, dy);

    if (x < -50 || y < -50 || x > bounds.w + 50 || y > bounds.h + 50) {
      break;
    }
  }

  if (points.length < 3) return;

  let d = `M${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;
  for (let i = 1; i < points.length - 1; i++) {
    const cx = points[i].x;
    const cy = points[i].y;
    const next = points[i + 1];
    const mx = (cx + next.x) / 2;
    const my = (cy + next.y) / 2;
    d += `Q${cx.toFixed(1)},${cy.toFixed(1)} ${mx.toFixed(1)},${my.toFixed(1)}`;
  }
  const last = points[points.length - 1];
  d += `T${last.x.toFixed(1)},${last.y.toFixed(1)}`;

  const opacity = Math.max(0.12, 0.65 - depth * 0.08);
  const width = Math.max(0.4, 1.1 - depth * 0.12);
  const delay = depth * 0.45 + rng() * 0.55;
  strands.push({ d, approxLength: totalLen, delay, opacity, width });

  const tipIdx = points.length - 1;
  const tip = points[tipIdx];
  const prev = points[tipIdx - 1];
  const tipAngle = Math.atan2(tip.y - prev.y, tip.x - prev.x);

  const branchProb = Math.max(0.25, 0.82 - depth * 0.14);

  for (let attempt = 0; attempt < 2; attempt++) {
    if (rng() < branchProb) {
      const sign = rng() < 0.5 ? -1 : 1;
      const offset = (0.22 + rng() * 0.42) * sign;
      const childLen = length * (0.52 + rng() * 0.22);
      grow(tip, tipAngle + offset, childLen, depth + 1, rng, strands, bounds);
    }
  }

  // Occasional triple-branch (rare anastomosis-adjacent flourish, only at shallow depths)
  if (depth < 2 && rng() < 0.35) {
    const sign = rng() < 0.5 ? -1 : 1;
    const offset = (0.5 + rng() * 0.3) * sign;
    grow(tip, tipAngle + offset, length * 0.45, depth + 1, rng, strands, bounds);
  }
}

const VW = 1600;
const VH = 700;

const rng = makeRng(0x6172_7374); // "arst" — locked seed for stable render

const strands: Strand[] = [];

// Root spawn points around the edges, growing inward.
// Configured so strands envelope the hero without overrunning the centered copy.
const roots: Array<[number, number, number, number]> = [
  // [x, y, direction in radians, base length]
  [-20, 140, 0.18, 360],
  [-20, 360, -0.12, 320],
  [VW + 20, 110, Math.PI - 0.22, 320],
  [VW + 20, 380, Math.PI + 0.18, 360],
  [VW * 0.25, VH + 30, -Math.PI * 0.42, 240],
  [VW * 0.75, VH + 30, -Math.PI * 0.58, 240],
];

for (const [rx, ry, dir, baseLen] of roots) {
  const len = baseLen + (rng() - 0.5) * 60;
  grow({ x: rx, y: ry }, dir, len, 0, rng, strands, { w: VW, h: VH });
}

// Sprinkle a few tiny "spore" dots near the densest junctions for character
const spores: Pt[] = [];
for (let i = 0; i < 7; i++) {
  spores.push({
    x: 80 + rng() * (VW - 160),
    y: 80 + rng() * (VH - 160),
  });
}
---

<svg
  class="mycelium"
  viewBox={`0 0 ${VW} ${VH}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="mycelium-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-moss)" stop-opacity="0.35" />
      <stop offset="100%" stop-color="var(--color-moss)" stop-opacity="0" />
    </radialGradient>
  </defs>

  <g class="mycelium__strands">
    {
      strands.map((s) => (
        <path
          d={s.d}
          style={`--len:${Math.ceil(s.approxLength)};--delay:${s.delay.toFixed(2)}s;--opacity:${s.opacity.toFixed(2)};stroke-width:${s.width.toFixed(2)}`}
        />
      ))
    }
  </g>

  <g class="mycelium__spores">
    {
      spores.map((p, i) => (
        <circle
          cx={p.x.toFixed(1)}
          cy={p.y.toFixed(1)}
          r={1.2}
          style={`--delay:${(2.2 + i * 0.18).toFixed(2)}s`}
        />
      ))
    }
  </g>
</svg>

<style>
  .mycelium {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    user-select: none;
  }

  .mycelium__strands path {
    fill: none;
    stroke: var(--color-moss);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    opacity: 0;
    animation:
      mycelium-grow 3.4s cubic-bezier(0.35, 0, 0.25, 1) forwards,
      mycelium-fade 0.8s ease-out forwards;
    animation-delay: var(--delay), var(--delay);
  }

  .mycelium__spores circle {
    fill: var(--color-spore);
    opacity: 0;
    animation: spore-bloom 1.6s ease-out forwards;
    animation-delay: var(--delay);
    transform-origin: center;
  }

  @keyframes mycelium-grow {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes mycelium-fade {
    to {
      opacity: var(--opacity);
    }
  }

  @keyframes spore-bloom {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    60% {
      opacity: 0.85;
      transform: scale(1.4);
    }
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mycelium__strands path,
    .mycelium__spores circle {
      animation: none;
      stroke-dashoffset: 0;
      opacity: var(--opacity, 0.45);
    }
  }
</style>
